# Copy to `.env` at the repository root and adjust values.
# Never commit `.env` with real secrets.

# --- Django (backend) ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL URL for Django (required in production; leave empty locally for SQLite).
# Docker Compose: postgres://sqms:sqms@db:5432/sqms
# Host machine: postgres://sqms:sqms@localhost:5432/sqms
DATABASE_URL=

# Public URL of the React app (no trailing slash). Used for QR join links.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Comma-separated browser origins for django-cors-headers (SPA must be listed).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Django CSRF trusted origins (include your public site URL in production).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set True when HTTPS is terminated in front of Django (Nginx / load balancer).
SECURE_SSL_REDIRECT=False

# Optional HSTS (seconds). Only applied when SECURE_SSL_REDIRECT=True.
# SECURE_HSTS_SECONDS=31536000

# --- PostgreSQL (docker-compose `db` service) ---
POSTGRES_USER=sqms
POSTGRES_PASSWORD=sqms
POSTGRES_DB=sqms
POSTGRES_PORT=5432

# Host port for the Django/Gunicorn container (development compose).
BACKEND_PORT=8000

# --- Frontend (Vite) ---
# Development: leave empty to use the Vite proxy for `/api`.
# Production build: API origin seen by the browser (no trailing slash), e.g. https://api.example.com
# Docker prod stack: usually http://localhost (same origin via Nginx).
VITE_API_BASE_URL=

FRONTEND_PORT=5173

# Production Nginx HTTP port (docker-compose.prod.yml).
NGINX_HTTP_PORT=80

# --- Gunicorn (optional overrides; see backend/gunicorn.conf.py) ---
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=60
# GUNICORN_LOG_LEVEL=info

# --- Notifications (optional; placeholders log until backends are implemented) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@example.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FCM_SERVICE_ACCOUNT_JSON=
