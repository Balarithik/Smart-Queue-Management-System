# Copy to `.env` at the repository root and adjust values.

# --- Django (backend) ---
# Used when running locally or passed through docker-compose for the backend service.
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL URL for Django (leave unset locally to use SQLite).
# Example for Docker Compose from the host (e.g. tooling on your machine):
# DATABASE_URL=postgres://sqms:sqms@localhost:5432/sqms
DATABASE_URL=

# Comma-separated browser origins for django-cors-headers.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# --- PostgreSQL (docker-compose `db` service) ---
POSTGRES_USER=sqms
POSTGRES_PASSWORD=sqms
POSTGRES_DB=sqms
POSTGRES_PORT=5432

# Host port for the Django container (optional override).
BACKEND_PORT=8000

# --- Frontend (Vite) ---
# Leave empty in development to use relative `/api/...` URLs through the Vite proxy.
# For production builds, set to your API origin (no trailing slash), e.g. https://api.example.com
VITE_API_BASE_URL=

FRONTEND_PORT=5173
