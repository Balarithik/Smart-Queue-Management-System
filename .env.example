# Copy to `.env` at the repository root for local development.
# On Render, set these in each service's Environment dashboard (never commit real secrets).

# --- Docker all-in-one (Nginx + Gunicorn + SPA on one host) ---
# FRONTEND_ORIGIN / CORS / CSRF = your public URL (e.g. https://app.onrender.com).
# VITE_API_BASE_URL is not used (same-origin /api).

# --- Django API (Render Web Service — root directory: backend) ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
LOG_LEVEL=INFO

# Render PostgreSQL (Internal Database URL from dashboard)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# API hostname(s), comma-separated. Render sets RENDER_EXTERNAL_HOSTNAME automatically;
# you can also add your custom domain here.
ALLOWED_HOSTS=localhost,127.0.0.1,your-api.onrender.com

# Public SPA URL (no trailing slash). Used in QR join links.
FRONTEND_ORIGIN=https://your-app.onrender.com

# Comma-separated origins for the React static site (must match FRONTEND_ORIGIN in production).
CORS_ALLOWED_ORIGINS=https://your-app.onrender.com
CORS_ALLOW_CREDENTIALS=True

# Same origins for Django admin CSRF (https only in production).
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# True on Render (HTTPS terminated at the edge).
SECURE_SSL_REDIRECT=True

# Serve uploaded queue banners and QR PNGs from Django (required on Render; default true when
# RENDER_EXTERNAL_HOSTNAME is set). Uploaded files use ephemeral disk unless you add a disk mount.
SERVE_MEDIA=True

# Optional HSTS (seconds). Only applied when SECURE_SSL_REDIRECT=True.
# SECURE_HSTS_SECONDS=31536000

# Max queue banner image upload size in bytes (JPEG/PNG only; default 2 MB).
QUEUE_IMAGE_MAX_BYTES=2097152

# --- React static site (Render Static Site — root directory: frontend) ---
# Set at build time to your public API URL (no trailing slash).
VITE_API_BASE_URL=https://your-api.onrender.com

# --- Gunicorn (optional; Render sets PORT automatically) ---
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# --- Notifications (optional; placeholders log until backends are implemented) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@example.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FCM_SERVICE_ACCOUNT_JSON=
